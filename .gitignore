node_modules/
*.tsbuildinfo
sample-data/

# Sample sessions are evidence, not source. Hundreds of MB of MP4 per copy;
# point PLAYERONE_SESSIONS at them instead.
docs/sample_data/

# Screenshot rounds are evidence, not source.
.impeccable/review/
apps/console/dist/

# Extracted vendor SDKs and the kit they come from: hundreds of MB, not source.
tools/*
# The risk engine's media analysers are source, and the one thing under tools/ that is.
!tools/analysers/
docs/sdks/
# OrbbecSDK writes this wherever it is run from.
Log/
__pycache__/

# Secrets. The database password and the ZaloPay credentials
# (PLAYERONE_ZALOPAY_APP_ID, _KEY1, _PUBLIC_KEY, _PAYMENT_ID) are read from the
# environment and live in an untracked .env.local on each machine. This pattern
# is what keeps them out of a public repository.
.env
.env.*
!.env.example
