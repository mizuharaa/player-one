# Allowlist build inputs. No local credentials, recordings, agent artifacts,
# screenshot rounds, SDK archives or docs media can enter the build context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/
!patches/*.patch
!packages/
!packages/api/
!packages/api/package.json
!packages/api/src/
!packages/api/src/**
!packages/api/bin/
!packages/api/bin/serve.ts
!packages/api/bin/bootstrap.ts
!packages/api/scripts/
!packages/api/scripts/seed-stakeholder.mjs
!packages/api/scripts/seed-demo.mjs
!packages/api/scripts/seed-demo-work.mjs
!packages/api/scripts/e2e-loop.mjs
!packages/api/scripts/session-footage.mjs
!packages/api/scripts/card-intake.mjs
!packages/api/scripts/bucket-cors.mjs
!packages/contracts/
!packages/contracts/package.json
!packages/contracts/src/
!packages/contracts/src/**
!packages/store/
!packages/store/package.json
!packages/store/src/
!packages/store/src/**
!packages/store/drizzle/
!packages/store/drizzle/**
!packages/store/drizzle.config.ts
# The API imports the ingest engine directly (collector-upload.ts), so the
# runtime cannot start without it. Left out here, the image built and then
# died on ERR_MODULE_NOT_FOUND at boot.
!packages/ingest/
!packages/ingest/package.json
!packages/ingest/src/
!packages/ingest/src/**
!packages/design/
!packages/design/package.json
!packages/design/src/
!packages/design/src/**
!packages/design/scripts/
!packages/design/scripts/**
!packages/design/generated/
!packages/design/generated/**
!apps/
!apps/console/
!apps/console/package.json
!apps/console/index.html
!apps/console/tsconfig.json
!apps/console/vite.config.ts
!apps/console/src/
!apps/console/src/**
!apps/console/public/
!apps/console/public/**
!tools/
!tools/analysers/
!tools/analysers/**
!deploy/
!deploy/*.mjs
!deploy/cloud/
!deploy/cloud/*.mjs
**/.env
**/.env.*
**/node_modules
**/*.test.*
**/scratchpad/**
**/*.log
**/*.map
