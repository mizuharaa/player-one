{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "development"
      }
    },
    "demo": {
      "distribution": "internal",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "demo",
        "EXPO_PUBLIC_API_URL": "https://demo.playerone.invalid",
        "PLAYERONE_VERSION_CODE": "41"
      }
    },
    "store": {
      "distribution": "store",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "play",
        "EXPO_PUBLIC_API_URL": "https://api.playerone.vng.com.vn",
        "PLAYERONE_VERSION_CODE": "41"
      }
    },
    "simulator": {
      "extends": "demo",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "demo",
      "distribution": "store"
    }
  },
  "submit": {
    "store": {
      "ios": {
        "ascAppId": "$EAS_SUBMIT_ASC_APP_ID",
        "appleId": "$EAS_SUBMIT_APPLE_ID",
        "appleTeamId": "$EAS_SUBMIT_APPLE_TEAM_ID"
      }
    },
    "testflight": {
      "ios": {
        "appleId": "$EAS_SUBMIT_APPLE_ID",
        "ascAppId": "$EAS_SUBMIT_ASC_APP_ID",
        "appleTeamId": "$EAS_SUBMIT_APPLE_TEAM_ID"
      }
    }
  }
}
