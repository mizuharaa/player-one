{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "development"
      },
      "pnpm": "9.15.9"
    },
    "demo": {
      "distribution": "internal",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "demo",
        "EXPO_PUBLIC_API_URL": "https://api.playerone.vng.com.vn",
        "PLAYERONE_VERSION_CODE": "43"
      },
      "pnpm": "9.15.9"
    },
    "store": {
      "distribution": "store",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "play",
        "EXPO_PUBLIC_API_URL": "https://api.playerone.vng.com.vn",
        "PLAYERONE_VERSION_CODE": "41"
      },
      "pnpm": "9.15.9"
    },
    "simulator": {
      "extends": "demo",
      "ios": {
        "simulator": true
      },
      "pnpm": "9.15.9"
    },
    "testflight": {
      "extends": "demo",
      "distribution": "store",
      "env": {
        "PLAYERONE_BUILD_PROFILE": "demo",
        "EXPO_PUBLIC_API_URL": "https://api.playerone.vng.com.vn",
        "PLAYERONE_VERSION_CODE": "43"
      },
