{
  "name": "PlayerOneCollector",
  "displayName": "Player One",
  "expo": {
    "name": "Player One",
    "slug": "playerone-collector",
    "scheme": "playerone",
    "version": "0.0.1",
    "orientation": "portrait",
    "android": {
      "package": "vn.vng.playerone.collector",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4E4368"
      }
    },
    "ios": {
      "bundleIdentifier": "vn.vng.playerone.collector",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Face ID unlocks your saved sign-in so you do not have to request a new code every time.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth connects to your Ego camera to set it up and check its status.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Be Vietnam Pro",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/BeVietnamPro-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/BeVietnamPro-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/BeVietnamPro-Regular.ttf",
              "./assets/fonts/BeVietnamPro-Medium.ttf",
              "./assets/fonts/BeVietnamPro-SemiBold.ttf",
              "./assets/fonts/BeVietnamPro-Bold.ttf",
              "./assets/fonts/BeVietnamPro-ExtraBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Player One uses the photos and videos you choose for an unmeasured upload.",
          "cameraPermission": "Player One uses the camera when you choose Take Photo.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "8b41f363-bb73-49cc-8111-cff31171f29b"
      }
    },
    "owner": "trkang"
  }
}
