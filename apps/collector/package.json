{
  "name": "@playerone/collector",
  "version": "0.0.0",
  "private": true,
  "description": "Player One collector app (Expo / React Native), with a real HTTP client and mocked device layer — see README.md.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "vite --config web/vite.config.ts",
    "shots": "node web/shots.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "test:release": "node --test scripts/*.test.mjs",
    "apk": "node scripts/build-android.mjs demo",
    "aab": "node scripts/build-android.mjs play"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system"
        ]
      }
    }
  },
  "dependencies": {
    "@playerone/delivery": "workspace:*",
    "@playerone/design": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "expo": "57.0.20",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "57.0.3",
    "expo-video": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@types/react": "^19.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "react-dom": "^19.1.0",
    "react-native-web": "^0.21.0",
    "vite": "^6.0.7"
  }
}
