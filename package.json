{
  "name": "playerone",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --testTimeout=30000",
    "ingest": "node packages/ingest/bin/ingest.ts",
    "serve": "node packages/api/bin/serve.ts",
    "moov": "node packages/api/scripts/moov.ts",
    "fixtures": "node packages/ingest/scripts/make-fixtures.ts",
    "bench": "node packages/ingest/scripts/bench.ts",
    "db:generate": "drizzle-kit generate --config packages/store/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/store/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": "^3.1.6"
    }
  }
}
