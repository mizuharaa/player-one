# KEY=value, without quotes or spaces around =. Comments start with #.
# Same variable names as deploy/centre/centre.env.example; the paths are the
# container's, not the VM's. Copy to cloud.env, which git ignores, and replace
# every REPLACE_ value. A template is not a deployment.
PLAYERONE_DEPLOY_MODE=https-production
PLAYERONE_PUBLIC_URL=https://REPLACE_PUBLIC_HOSTNAME
# The interface Caddy binds inside its container, not the VM's public address:
# what the internet reaches is the published 80/443 in docker-compose.yml.
PLAYERONE_BIND=0.0.0.0
# Let's Encrypt account address, for expiry and revocation notices.
PLAYERONE_ACME_EMAIL=REPLACE_OPERATIONS_EMAIL
# Where Caddy reads the console build, and where the `console` volume is
# mounted for it. The volume is seeded from the API image.
PLAYERONE_CONSOLE_ROOT=/srv/console
# The `backups` volume. pg_dump output belongs on a disk that outlives the
# container; SEC-06 disk encryption on the VM is still operations work.
PLAYERONE_BACKUP_DIR=/data/backups
# The `postgres` service of docker-compose.yml. For a managed database, use its
# host and ?sslmode=require instead — ?sslmode=disable here states that the
# docker bridge on one VM is the trusted link, which is what db.ts asks.
# Never the migration owner: migration 0021 created playerone_app, and
# packages/store/src/db.ts refuses to run as a superuser.
DATABASE_URL=postgres://playerone_app:REPLACE_DATABASE_PASSWORD@postgres:5432/po_demo_cloud?sslmode=disable
# Read only by the `postgres` service, and only on its first start: the owner
# password of the container database, and the database it creates.
POSTGRES_PASSWORD=REPLACE_OWNER_PASSWORD
POSTGRES_DB=po_demo_cloud
# Migration/backup credential only; the server always uses DATABASE_URL.
OWNER_DATABASE_URL=postgres://postgres:REPLACE_OWNER_PASSWORD@postgres:5432/po_demo_cloud
PLAYERONE_APP_PASSWORD=REPLACE_DATABASE_PASSWORD
PLAYERONE_LOCAL_DB=1
PLAYERONE_IMAGE=playerone-api:local
PLAYERONE_MIGRATE_IMAGE=playerone-migrate:local
PLAYERONE_SOURCE_SHA=unknown
PLAYERONE_DEMO_MACHINE_SECRET=REPLACE_MACHINE_SECRET
PLAYERONE_DEMO_ADMIN_SECRET=REPLACE_OPERATOR_SECRET
PLAYERONE_DEMO_FINANCE_SECRET=REPLACE_FINANCE_SECRET
PLAYERONE_DEMO_REVIEWER_SECRET=REPLACE_REVIEWER_SECRET
PLAYERONE_TOKEN_SECRET=REPLACE_TOKEN_SECRET
# The `media` volume. Imported ego_* folders live here and must survive
# `docker compose down`; a container filesystem does not.
PLAYERONE_MEDIA_ROOT=/data/media
PLAYERONE_MACHINE_IDENTIFIER=REPLACE_MACHINE_IDENTIFIER
PLAYERONE_MACHINE_SECRET=REPLACE_MACHINE_SECRET
PLAYERONE_OPERATOR_REF=REPLACE_OPERATOR_REF
PLAYERONE_OPERATOR_SECRET=REPLACE_OPERATOR_SECRET
# GreenNode's S3-compatible endpoint, its bucket and that bucket's keys. Both
# the bytes and this VM stay in Vietnam; reviewers in China reach the console
# over HTTPS and, while PLAYERONE_REVIEWER_MEDIA=0, receive no footage.
STORAGE_ENDPOINT=https://REPLACE_GREENNODE_S3_ENDPOINT
STORAGE_BUCKET=REPLACE_STORAGE_BUCKET
STORAGE_KEY=REPLACE_STORAGE_KEY
STORAGE_SECRET=REPLACE_STORAGE_SECRET
PLAYERONE_STORAGE_QUOTA_BYTES=REPLACE_ACTUAL_ALLOCATION_BYTES
REVIEW_VERIFICATION_GATE=cloud
# Loopback inside Caddy's network namespace, which is why the forwarded client
# address can be trusted at all. Do not publish this port.
HOST=127.0.0.1
PORT=8080
PLAYERONE_TRUST_LOOPBACK_PROXY=1
PLAYERONE_SECURE_COOKIES=1
PLAYERONE_REVIEWER_MEDIA=0
PLAYERONE_PAYOUT_MODE=manual
PLAYERONE_ZALOPAY_ENV=sandbox
# Sandbox means sign-in codes are written to the API's own container log and
# not delivered. Good enough to walk the loop with staff; not a collector
# sign-in. Set PLAYERONE_ZNS_ENV=production with PLAYERONE_ZNS_ACCESS_TOKEN and
# PLAYERONE_ZNS_TEMPLATE_ID when VNG has issued the ZNS account. No demo phone
# belongs on a public hostname.
PLAYERONE_ZNS_ENV=sandbox
# The ONLY numbers whose sign-in code this server will write to its own log,
# comma-separated. Sandbox with no ZNS credentials falls back to the log sender
# — which is this file's own default — and before this allowlist existed that
# sender printed EVERY number's code, so a public deployment put real
# collectors' one-time codes where anyone with log access could read them.
# Empty discloses nothing. Put the demo handset here (the same value as
# PLAYERONE_DEMO_PHONE) and nothing else; any other number gets a loud line
# with no code and only its last three digits.
PLAYERONE_DEMO_PHONES=
# Which channel carries the one-time code: zns, sms or log. EMPTY keeps the
# behaviour above, and that is the default on purpose. Naming one is a
# commitment: zns and sms both refuse to start without their credentials,
# because a deployment that asked for a channel and silently logged instead
# looks exactly like a working one. See packages/api/src/zns.ts.
PLAYERONE_SIGN_IN_CHANNEL=
# Zalo Login (OAuth v4), the way a collector with an ordinary Zalo account
# signs in — owner's decision 2026-09-16, because VNG's ZNS Official Account is
# not available. From developers.zalo.me; the callback URL registered there must
# equal PLAYERONE_PUBLIC_URL + /auth/collector/zalo/callback byte for byte, and
# docs/cloud-go-live.md has the exact settings page. Leave both EMPTY and the
# three Zalo routes answer 503 naming zalo_not_configured; set one without the
# other and the server refuses to start, naming what is missing.
PLAYERONE_ZALO_APP_ID=
PLAYERONE_ZALO_APP_SECRET=
# Zalo's numeric account id (from graph.zalo.me/v2.0/me) for the phone that
# will be used on stage. Read by scripts/seed-demo.mjs, which puts it on the
# demo collector so "Tiếp tục với Zalo" and the phone code land on the SAME
# qualified row. Empty and the two ways in make two rows, and the Zalo one is a
# prospect that cannot claim anything. Not a secret: it names an account, it
# does not authenticate one.
PLAYERONE_DEMO_ZALO_ID=
# The redirect URI is built from this. Unset, it falls back to
# PLAYERONE_PUBLIC_URL above, which is the same string on every deployment so
# far — set it only where the API's public origin is not the console's.
PLAYERONE_PUBLIC_ORIGIN=
# The ZNS Official Account token, which EXPIRES AFTER 25 HOURS. Set the refresh
# token instead of PLAYERONE_ZNS_ACCESS_TOKEN and the server keeps it alive;
# the value here is only the seed, because Zalo's refresh token is single-use
# and rotates. The rotated one is written to the file below, which must be on a
# volume that outlives the container — losing it needs an OA administrator to
# re-authorize by hand. The app id and secret above are the same pair.
PLAYERONE_ZNS_REFRESH_TOKEN=
PLAYERONE_ZNS_TOKEN_FILE=/data/media/zns-oa-token.json
# The SMS fallback, eSMS.vn, for numbers ZNS structurally cannot reach: no Zalo
# account, or the channel refused. The brandname needs a business registration
# licence and 5-10 business days — docs/sign-in-channels.md has the owner steps.
PLAYERONE_SMS_API_KEY=
PLAYERONE_SMS_SECRET_KEY=
PLAYERONE_SMS_BRANDNAME=
# eSMS's own test mode: charged nothing, delivered nowhere. 1 while the
# brandname is still in approval, so the request path can be exercised.
PLAYERONE_SMS_SANDBOX=0
