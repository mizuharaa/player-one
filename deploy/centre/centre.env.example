# KEY=value, without quotes or spaces around =. Comments start with #.
PLAYERONE_DEPLOY_MODE=lan-demo
PLAYERONE_PUBLIC_URL=http://REPLACE_LAN_IP
PLAYERONE_BIND=REPLACE_LAN_IP
PLAYERONE_CONSOLE_ROOT=C:/PlayerOne/apps/console/dist
PLAYERONE_BACKUP_DIR=REPLACE_ENCRYPTED_BACKUP_DIRECTORY
PLAYERONE_NODE_EXE=C:\Program Files\nodejs\node.exe
PLAYERONE_CADDY_EXE=C:\Tools\Caddy\caddy.exe
DATABASE_URL=postgres://playerone_app:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/playerone
PLAYERONE_TOKEN_SECRET=REPLACE_TOKEN_SECRET
PLAYERONE_MEDIA_ROOT=C:\PlayerOne\media
PLAYERONE_MACHINE_IDENTIFIER=counter-1
PLAYERONE_MACHINE_SECRET=REPLACE_MACHINE_SECRET
PLAYERONE_OPERATOR_REF=clerk-1
PLAYERONE_OPERATOR_SECRET=REPLACE_CLERK_SECRET
STORAGE_ENDPOINT=https://REPLACE_STORAGE_ENDPOINT
STORAGE_BUCKET=REPLACE_STORAGE_BUCKET
STORAGE_KEY=REPLACE_STORAGE_KEY
STORAGE_SECRET=REPLACE_STORAGE_SECRET
PLAYERONE_STORAGE_QUOTA_BYTES=REPLACE_ACTUAL_ALLOCATION_BYTES
REVIEW_VERIFICATION_GATE=cloud
HOST=127.0.0.1
PORT=8080
PLAYERONE_SECURE_COOKIES=0
PLAYERONE_REVIEWER_MEDIA=0
PLAYERONE_PAYOUT_MODE=manual
PLAYERONE_ZALOPAY_ENV=sandbox
PLAYERONE_ZNS_ENV=sandbox
# Supply the specifically approved demo phone and seed it in the demo database,
# OR set both PLAYERONE_ZNS_ACCESS_TOKEN and PLAYERONE_ZNS_TEMPLATE_ID.
# No default phone or real credentials are supplied in this template.
